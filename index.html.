<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#fde8ea">
<title>Happy Birthday 💖</title>

<!-- Google Fonts (only external dependency). If offline, the page falls back to cursive / Georgia. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Lora:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* ============ THEME (change colors here) ============ */
  :root {
    --blush: #fde8ea;
    --cream: #fff8f0;
    --rose: #d6577b;
    --burgundy: #7a1f3d;
    --burgundy-dark: #5c1530;
    --gold: #c9a15b;
    --ink: #4a1a2b;
    --good: #2f7d5b;
    --script: 'Great Vibes', 'Snell Roundhand', cursive;
    --serif: 'Lora', Georgia, 'Times New Roman', serif;
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    font-family: var(--serif);
    color: var(--ink);
    background: linear-gradient(160deg, var(--blush) 0%, var(--cream) 55%, #fbd9de 100%);
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(20px, env(safe-area-inset-top)) 16px max(20px, env(safe-area-inset-bottom));
    overflow-x: hidden;
  }

  [tabindex="-1"]:focus { outline: none; }

  /* ============ Floating hearts / petals background ============ */
  #floaters {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .floater {
    position: absolute;
    bottom: -50px;
    color: var(--rose);
    opacity: 0;
    animation: floatUp linear infinite;
    user-select: none;
  }
  @keyframes floatUp {
    0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
    10%  { opacity: .55; }
    90%  { opacity: .35; }
    100% { transform: translateY(-115vh) rotate(40deg); opacity: 0; }
  }

  /* ============ Layout / cards ============ */
  .app {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
  }

  .card {
    background: rgba(255, 255, 255, .86);
    border: 1px solid rgba(201, 161, 91, .55);
    border-radius: 28px;
    padding: 32px 24px;
    box-shadow: 0 18px 45px rgba(122, 31, 61, .15);
    text-align: center;
  }

  .screen.enter   { animation: slideIn .6s ease both; }
  .screen.leaving { animation: fadeOut .3s ease both; }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeOut {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(-10px); }
  }

  .eyebrow {
    margin: 0 0 6px;
    font-size: .85rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--rose);
    font-weight: 600;
  }

  h1, h2 {
    font-family: var(--script);
    font-weight: 400;
    color: var(--burgundy);
    margin: 0 0 12px;
    line-height: 1.15;
  }
  h1 { font-size: clamp(2.8rem, 13vw, 4rem); }
  h2 { font-size: clamp(2rem, 9vw, 2.6rem); }

  p { margin: 0 0 16px; line-height: 1.6; font-size: 1.05rem; }

  .big-emoji {
    font-size: 3.4rem;
    display: inline-block;
    animation: bob 2.6s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* ============ Buttons ============ */
  .btn {
    font: inherit;
    font-weight: 600;
    font-size: 1.1rem;
    min-height: 56px;
    padding: 14px 32px;
    border-radius: 999px;
    border: 2px solid var(--burgundy);
    background: var(--burgundy);
    color: #fff;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    box-shadow: 0 8px 20px rgba(122, 31, 61, .25);
  }
  .btn:hover { background: var(--burgundy-dark); transform: translateY(-2px); box-shadow: 0 12px 26px rgba(122, 31, 61, .3); }
  .btn:active { transform: translateY(0) scale(.98); }
  .btn:focus-visible,
  .option:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  .btn-ghost {
    background: #fff;
    color: var(--burgundy);
    box-shadow: none;
  }
  .btn-ghost:hover { background: var(--blush); }

  .btn-link {
    background: none;
    border: none;
    box-shadow: none;
    color: var(--burgundy);
    font-size: .95rem;
    text-decoration: underline;
    min-height: 44px;
    padding: 8px 16px;
    margin-top: 12px;
  }
  .btn-link:hover { background: none; transform: none; box-shadow: none; color: var(--rose); }

  /* ============ Quiz ============ */
  .progress-label { font-size: .9rem; color: var(--rose); font-weight: 600; margin-bottom: 8px; }
  .progress {
    height: 8px;
    background: var(--blush);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 22px;
  }
  .progress > div {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--rose), var(--gold));
    border-radius: 999px;
    transition: width .5s ease;
  }

  #q-text { font-size: clamp(1.9rem, 8vw, 2.3rem); margin-bottom: 20px; }

  .options { text-align: left; }
  .option {
    display: block;
    width: 100%;
    min-height: 58px;
    margin: 0 0 12px;
    padding: 14px 18px;
    font: inherit;
    font-size: 1.05rem;
    text-align: left;
    color: var(--ink);
    background: #fff;
    border: 2px solid rgba(122, 31, 61, .25);
    border-radius: 16px;
    cursor: pointer;
    transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease, opacity .3s ease;
  }
  .option:hover:not(:disabled) {
    border-color: var(--rose);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(214, 87, 123, .2);
  }
  .option:disabled { cursor: default; color: var(--ink); }
  .option.correct { background: #e8f5ee; border-color: var(--good); }
  .option.wrong   { background: #fdecee; border-color: var(--rose); animation: shake .4s ease; }
  .option.dim     { opacity: .55; }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  .reaction {
    margin: 8px 0 16px;
    padding: 16px;
    background: var(--blush);
    border-radius: 16px;
    animation: pop .5s ease both;
  }
  .reaction .emoji { display: block; font-size: 2.2rem; margin-bottom: 4px; }
  .reaction p { margin: 0; }
  @keyframes pop {
    0%   { opacity: 0; transform: scale(.85); }
    70%  { transform: scale(1.04); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* ============ Score ============ */
  .score-number {
    font-family: var(--script);
    font-size: 4.5rem;
    color: var(--rose);
    line-height: 1;
    margin: 4px 0 8px;
  }

  /* ============ Final question ============ */
  .ask-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 170px;
    margin-top: 12px;
  }
  #yes-btn { transition: transform .25s ease, background .2s ease, box-shadow .2s ease; }
  #no-btn.floating {
    position: fixed;
    z-index: 50;
    transition: left .25s ease, top .25s ease, background .2s ease;
  }

  #confetti {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 100;
  }

  .signature { font-family: var(--script); font-size: 2.2rem; color: var(--rose); margin: 8px 0 0; }

  /* Polaroid-style photo on the final screen */
  .photo-frame {
    margin: 4px auto 18px;
    padding: 10px 10px 14px;
    max-width: 320px;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 12px 30px rgba(122, 31, 61, .25);
    transform: rotate(-2deg);
    animation: photoIn .8s ease .4s both;
  }
  @keyframes photoIn {
    0%   { opacity: 0; transform: rotate(-2deg) scale(.85); }
    70%  { transform: rotate(-2deg) scale(1.04); }
    100% { opacity: 1; transform: rotate(-2deg) scale(1); }
  }
  .photo-frame[hidden] { display: none; }
  .photo-frame img {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: 3px;
  }
  .photo-frame figcaption {
    font-family: var(--script);
    font-size: 1.7rem;
    color: var(--burgundy);
    margin-top: 8px;
    line-height: 1.2;
  }

  /* ============ Reduced motion ============ */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
    #floaters { display: none; }
  }
</style>
</head>

<body>

<div id="floaters" aria-hidden="true"></div>
<canvas id="confetti" aria-hidden="true"></canvas>

<main class="app">

  <!-- 1. Landing -->
  <section id="screen-landing" class="screen card enter">
    <span class="big-emoji" aria-hidden="true">🎂</span>
    <p class="eyebrow" id="landing-eyebrow"></p>
    <h1 id="landing-title"></h1>
    <p id="landing-sub"></p>
    <button type="button" class="btn" id="landing-btn"></button>
  </section>

  <!-- 2. Quiz -->
  <section id="screen-quiz" class="screen card" hidden>
    <div class="progress-label" id="q-count"></div>
    <div class="progress" aria-hidden="true"><div id="q-bar"></div></div>
    <h2 id="q-text"></h2>
    <div class="options" id="q-options"></div>
    <div class="reaction" id="q-reaction" aria-live="polite" hidden>
      <span class="emoji" id="q-emoji" aria-hidden="true"></span>
      <p id="q-reaction-text"></p>
    </div>
    <button type="button" class="btn" id="q-next" hidden></button>
  </section>

  <!-- 3. Score -->
  <section id="screen-score" class="screen card" hidden>
    <p class="eyebrow">Your score</p>
    <div class="score-number" id="score-number"></div>
    <h2 id="score-title"></h2>
    <p id="score-message"></p>
    <button type="button" class="btn" id="score-btn"></button>
  </section>

  <!-- 4. Final question -->
  <section id="screen-ask" class="screen card" hidden>
    <span class="big-emoji" aria-hidden="true">💍</span>
    <h2 id="ask-text"></h2>
    <p id="ask-sub"></p>
    <div class="ask-buttons" id="ask-buttons">
      <button type="button" class="btn" id="yes-btn"></button>
      <button type="button" class="btn btn-ghost" id="no-btn"></button>
    </div>
  </section>

  <!-- 5. Celebration -->
  <section id="screen-celebrate" class="screen card" hidden>
    <span class="big-emoji" aria-hidden="true">🎉</span>
    <h2 id="cel-title"></h2>
    <p id="cel-message"></p>
    <!-- Photo: shown only if CONFIG.celebrate.photo.src loads successfully -->
    <figure class="photo-frame" id="cel-photo" hidden>
      <img id="cel-photo-img" alt="A photo of us">
      <figcaption id="cel-photo-caption"></figcaption>
    </figure>
    <p class="signature" id="cel-signature"></p>
    <button type="button" class="btn btn-link" id="replay-btn"></button>
  </section>

</main>

<script>
/* =====================================================================
   CONFIGURATION: edit ONLY this block to personalize the page.
   All text on the page comes from here.
   ===================================================================== */
const CONFIG = {
  partnerName: "Waasi",
  fromName: "Marshmallow",      // signed at the end; change or leave "" to hide

  landing: {
    eyebrow: "A little surprise, just for you",
    title: "Happy Birthday, {name}",      // {name} is replaced with partnerName
    subtitle: "I made something small for your big day. It takes about two minutes, and there may be questions.",
    button: "Open your surprise 💌"
  },

  quiz: {
    nextLabel: "Next question →",
    finishLabel: "See my score ✨",

    /* correct = index (starting at 0) of the right answer.
       EDIT: swap these for REAL memories and inside jokes. That's what
       makes it feel personal. Set `correct` to whichever option is true. */
    questions: [
      {
        text: "Who said “I love you” first?",
        options: ["Me 🙋‍♀️", "You 😎", "We said it at the same time", "Neither, we just knew 🥹"],
        correct: 1,
        right: "Correct! And I still remember how happy it made me.",
        wrong: "Ooh, not quite! But I love that you tried to take the credit 😌"
      },
      {
        text: "What do I secretly steal from you the most?",
        options: ["Your hoodie 🧥", "Your fries 🍟", "The blanket 🛏️", "Your whole heart 💘"],
        correct: 3,
        right: "Obviously. No refunds, no returns.",
        wrong: "That's also true, but my biggest crime is your heart 💘"
      },
      {
        text: "What's my favorite thing to do with you?",
        options: ["Long drives and long talks", "Eating way too much food", "Doing absolutely nothing together", "Anything, as long as it's with you"],
        correct: 3,
        right: "Yes! Any place is a good place when you're there.",
        wrong: "Cute guess! But the real answer is: anything, as long as it's with you 🥰"
      },
      {
        text: "What happens when your name pops up on my phone?",
        options: ["Ugh, him again 😒", "Oh no, what did I forget?", "My heart does a little dance 💃", "I check if he's bringing snacks"],
        correct: 2,
        right: "Every. Single. Time. 💃",
        wrong: "Rude! (The snacks part is slightly true, but the dancing heart wins.)"
      },
      {
        text: "If I could only keep one memory of us, which would it be?",
        options: ["The first time we met", "Our first inside joke", "A random, ordinary day with you", "I could never pick just one"],
        correct: 3,
        right: "You know me so well. Every memory with you is a keeper 🥹",
        wrong: "Close, but I could never choose. I'm keeping all of them 🥹"
      },
      {
        text: "How much do I love you?",
        options: ["A lot", "More than biryani 🍛", "To the moon and back 🌙", "All of the above, and more"],
        correct: 3,
        right: "All of the above, and then some. 💖",
        wrong: "Technically every option is true, but “all of the above” is the winner!"
      }
    ],

    /* Score screen: first tier whose `min` the score meets is shown. Keep sorted high to low. */
    results: [
      { min: 6, title: "Perfect score! 🏆", message: "You know me (and us) better than anyone. I'm keeping you." },
      { min: 4, title: "So close! 💕", message: "You clearly pay attention. I'm impressed, and a little bit in love (again)." },
      { min: 2, title: "Hmm... 😅", message: "We clearly need more dates to fix this. Lucky for us, I'm free." },
      { min: 0, title: "Zero?! 😂", message: "I'm not worried. You're still my favorite person in the world." }
    ],
    scoreButton: "One last question..."
  },

  ask: {
    question: "Will you be my partner for another year?",
    subtitle: "Think carefully. Or don't. There's only one right answer anyway.",
    yes: "Yes 💖",
    no: "No",
    /* Text the "No" button cycles through as it runs away */
    noTexts: ["No", "Are you sure? 🥺", "Think again 😌", "Wrong button!", "Nice try 😂", "Just say yes 💕", "Still no? 🙈"]
  },

  celebrate: {
    title: "Yay! You said yes 🎉",
    message: "Thank you for being the best part of my days. Happy Birthday, {name}. Here's to another year of us, and many more after that.",
    replay: "Play again",

    /* Photo on the final page.
       src: the file name of your photo placed in the SAME folder as this page
            (e.g. "photo.jpg"), OR a full "data:image/jpeg;base64,..." string
            if you want everything inside this single file.
       If the image can't be found, the photo area simply stays hidden. */
    photo: {
      src: "data:image/jpeg;base64,",
      caption: "Us, my favorite thing 💖",
      alt: "A photo of us"
    }
  },

  /* Floating background decorations */
  decorations: ["♥", "✿", "♥", "❀"]
};

/* =====================================================================
   LOGIC: no need to edit below this line.
   ===================================================================== */
(function () {
  const $ = (s) => document.querySelector(s);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fill = (str) => str.replace(/\{name\}/g, CONFIG.partnerName);
  const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];

  /* ---------- Fill static text ---------- */
  document.title = "Happy Birthday, " + CONFIG.partnerName + " 💖";
  $('#landing-eyebrow').textContent = CONFIG.landing.eyebrow;
  $('#landing-title').textContent = fill(CONFIG.landing.title);
  $('#landing-sub').textContent = CONFIG.landing.subtitle;
  $('#landing-btn').textContent = CONFIG.landing.button;
  $('#score-btn').textContent = CONFIG.quiz.scoreButton;
  $('#ask-text').textContent = CONFIG.ask.question;
  $('#ask-sub').textContent = CONFIG.ask.subtitle;
  $('#yes-btn').textContent = CONFIG.ask.yes;
  $('#no-btn').textContent = CONFIG.ask.noTexts[0] || CONFIG.ask.no;
  $('#cel-title').textContent = fill(CONFIG.celebrate.title);
  $('#cel-message').textContent = fill(CONFIG.celebrate.message);
  $('#cel-signature').textContent = CONFIG.fromName ? "— " + CONFIG.fromName : "";
  $('#replay-btn').textContent = CONFIG.celebrate.replay;

  /* ---------- Final-page photo (hidden unless it loads) ---------- */
  (function setupPhoto() {
    const p = CONFIG.celebrate.photo;
    if (!p || !p.src) return;
    const fig = $('#cel-photo');
    const img = $('#cel-photo-img');
    img.alt = p.alt || '';
    $('#cel-photo-caption').textContent = p.caption || '';
    img.addEventListener('load', () => { fig.hidden = false; });
    img.addEventListener('error', () => { fig.hidden = true; });
    img.src = p.src;
  })();

  /* ---------- Screen transitions ---------- */
  function showScreen(id) {
    const current = document.querySelector('.screen:not([hidden])');
    const next = document.getElementById(id);

    const go = () => {
      if (current) { current.hidden = true; current.classList.remove('leaving', 'enter'); }
      next.hidden = false;
      next.classList.add('enter');
      next.addEventListener('animationend', () => next.classList.remove('enter'), { once: true });
      const heading = next.querySelector('h1, h2');
      if (heading) { heading.setAttribute('tabindex', '-1'); heading.focus({ preventScroll: true }); }
      window.scrollTo(0, 0);
    };

    if (current && !reduceMotion) {
      current.classList.remove('enter');
      current.classList.add('leaving');
      setTimeout(go, 300);
    } else {
      go();
    }
  }

  /* ---------- Floating hearts / petals ---------- */
  (function makeFloaters() {
    const box = $('#floaters');
    for (let i = 0; i < 18; i++) {
      const el = document.createElement('span');
      el.className = 'floater';
      el.textContent = pick(CONFIG.decorations);
      el.style.left = Math.random() * 100 + '%';
      el.style.fontSize = (12 + Math.random() * 20) + 'px';
      const dur = 12 + Math.random() * 12;
      el.style.animationDuration = dur + 's';
      el.style.animationDelay = (-Math.random() * dur) + 's';
      box.appendChild(el);
    }
  })();

  /* ---------- Quiz ---------- */
  const Q = CONFIG.quiz.questions;
  let qi = 0, score = 0, answered = false;

  function renderQuestion() {
    const q = Q[qi];
    answered = false;
    $('#q-count').textContent = 'Question ' + (qi + 1) + ' of ' + Q.length;
    $('#q-bar').style.width = (qi / Q.length * 100) + '%';
    $('#q-text').textContent = q.text;

    const list = $('#q-options');
    list.replaceChildren();
    q.options.forEach((text, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'option';
      b.textContent = text;
      b.addEventListener('click', () => choose(i));
      list.appendChild(b);
    });

    $('#q-reaction').hidden = true;
    $('#q-next').hidden = true;
  }

  function choose(i) {
    if (answered) return;
    answered = true;

    const q = Q[qi];
    const ok = i === q.correct;
    if (ok) score++;

    [...$('#q-options').children].forEach((b, j) => {
      b.disabled = true;
      if (j === q.correct) b.classList.add('correct');
      else if (j === i) b.classList.add('wrong');
      else b.classList.add('dim');
    });

    $('#q-emoji').textContent = ok ? pick(['💖', '🥰', '✨', '😍']) : pick(['😂', '🙈', '🤭', '😜']);
    $('#q-reaction-text').textContent = ok ? q.right : q.wrong;

    // Re-trigger the pop animation each time
    const r = $('#q-reaction');
    r.hidden = false;
    r.style.animation = 'none'; void r.offsetWidth; r.style.animation = '';

    if (ok && !reduceMotion) burst(window.innerWidth / 2, window.innerHeight * 0.4, 18);

    const next = $('#q-next');
    next.textContent = (qi === Q.length - 1) ? CONFIG.quiz.finishLabel : CONFIG.quiz.nextLabel;
    next.hidden = false;
    next.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
  }

  $('#q-next').addEventListener('click', () => {
    if (qi < Q.length - 1) {
      qi++;
      renderQuestion();
      $('#q-text').setAttribute('tabindex', '-1');
      $('#q-text').focus({ preventScroll: true });
    } else {
      showScore();
    }
  });

  function showScore() {
    $('#q-bar').style.width = '100%';
    const tier = CONFIG.quiz.results.find((t) => score >= t.min) || CONFIG.quiz.results[CONFIG.quiz.results.length - 1];
    $('#score-number').textContent = score + ' / ' + Q.length;
    $('#score-title').textContent = tier.title;
    $('#score-message').textContent = tier.message;
    showScreen('screen-score');
  }

  $('#landing-btn').addEventListener('click', () => {
    qi = 0; score = 0;
    renderQuestion();
    showScreen('screen-quiz');
  });
  $('#score-btn').addEventListener('click', () => showScreen('screen-ask'));

  /* ---------- Runaway "No" button ---------- */
  const yesBtn = $('#yes-btn');
  const noBtn = $('#no-btn');
  const askBox = $('#ask-buttons');
  let dodgeCount = 0, lastDodge = 0, lastX = -999, lastY = -999, yesScale = 1;

  function overlaps(x, y, w, h, r, pad) {
    return x < r.right + pad && x + w > r.left - pad && y < r.bottom + pad && y + h > r.top - pad;
  }

  function dodge(e) {
    if (e && e.cancelable) e.preventDefault();
    const now = Date.now();
    if (now - lastDodge < 180) return;   // avoid double-firing from hover + touch
    lastDodge = now;

    // Move into <body> so no ancestor can affect position: fixed
    if (!noBtn.classList.contains('floating')) {
      noBtn.classList.add('floating');
      document.body.appendChild(noBtn);
    }

    const pad = 12;
    const w = noBtn.offsetWidth, h = noBtn.offsetHeight;
    const maxX = window.innerWidth - w - pad;
    const maxY = window.innerHeight - h - pad;
    const yesRect = yesBtn.getBoundingClientRect();

    let x, y, tries = 0;
    do {
      x = pad + Math.random() * Math.max(0, maxX - pad);
      y = pad + Math.random() * Math.max(0, maxY - pad);
      tries++;
    } while (tries < 25 && (Math.hypot(x - lastX, y - lastY) < 120 || overlaps(x, y, w, h, yesRect, 16)));

    lastX = x; lastY = y;
    noBtn.style.left = x + 'px';
    noBtn.style.top = y + 'px';

    // Cycle the label, and make "Yes" a little bigger each time
    dodgeCount++;
    const texts = CONFIG.ask.noTexts;
    noBtn.textContent = texts[dodgeCount % texts.length];
    yesScale = Math.min(1.5, yesScale + 0.06);
    yesBtn.style.transform = 'scale(' + yesScale + ')';
  }

  noBtn.addEventListener('pointerenter', dodge);
  noBtn.addEventListener('touchstart', dodge, { passive: false });
  noBtn.addEventListener('focus', dodge);
  noBtn.addEventListener('click', dodge);   // never counts as a "No"

  window.addEventListener('resize', () => {
    if (!noBtn.classList.contains('floating')) return;
    const maxX = window.innerWidth - noBtn.offsetWidth - 12;
    const maxY = window.innerHeight - noBtn.offsetHeight - 12;
    noBtn.style.left = Math.max(12, Math.min(parseFloat(noBtn.style.left) || 12, maxX)) + 'px';
    noBtn.style.top = Math.max(12, Math.min(parseFloat(noBtn.style.top) || 12, maxY)) + 'px';
  });

  function resetAsk() {
    noBtn.classList.remove('floating');
    noBtn.style.left = noBtn.style.top = '';
    noBtn.textContent = CONFIG.ask.noTexts[0] || CONFIG.ask.no;
    askBox.appendChild(noBtn);
    yesBtn.style.transform = '';
    yesScale = 1; dodgeCount = 0; lastX = lastY = -999;
  }

  yesBtn.addEventListener('click', () => {
    noBtn.remove();
    showScreen('screen-celebrate');
    celebrate();
  });

  $('#replay-btn').addEventListener('click', () => {
    resetAsk();
    showScreen('screen-landing');
  });

  /* ---------- Confetti (hearts + paper) ---------- */
  const canvas = $('#confetti');
  const ctx = canvas.getContext('2d');
  const colors = ['#d6577b', '#7a1f3d', '#c9a15b', '#f4a6b8', '#ffd9de', '#ffffff'];
  let particles = [], raf = null;

  function resizeCanvas() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  function burst(x, y, count) {
    for (let i = 0; i < count; i++) {
      particles.push({
        x, y,
        vx: (Math.random() - 0.5) * 12,
        vy: -Math.random() * 12 - 4,
        size: 6 + Math.random() * 8,
        rot: Math.random() * Math.PI * 2,
        vr: (Math.random() - 0.5) * 0.3,
        color: pick(colors),
        heart: Math.random() < 0.45,
        life: 0,
        max: 150 + Math.random() * 90
      });
    }
    if (!raf) raf = requestAnimationFrame(tick);
  }

  function drawHeart(s) {
    ctx.beginPath();
    ctx.moveTo(0, s * 0.35);
    ctx.bezierCurveTo(-s * 1.1, -s * 0.3, -s * 0.5, -s * 1.0, 0, -s * 0.4);
    ctx.bezierCurveTo(s * 0.5, -s * 1.0, s * 1.1, -s * 0.3, 0, s * 0.35);
    ctx.fill();
  }

  function tick() {
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    particles = particles.filter((p) => p.life < p.max && p.y < window.innerHeight + 40);
    for (const p of particles) {
      p.life++;
      p.vy += 0.25;
      p.vx *= 0.99;
      p.x += p.vx;
      p.y += p.vy;
      p.rot += p.vr;

      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.globalAlpha = Math.max(0, 1 - p.life / p.max);
      ctx.fillStyle = p.color;
      if (p.heart) drawHeart(p.size);
      else ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
      ctx.restore();
    }
    raf = particles.length ? requestAnimationFrame(tick) : null;
  }

  function celebrate() {
    const w = window.innerWidth, h = window.innerHeight;
    const scale = reduceMotion ? 0.3 : 1;
    burst(w / 2, h * 0.55, Math.round(90 * scale));
    setTimeout(() => burst(w * 0.15, h * 0.7, Math.round(60 * scale)), 250);
    setTimeout(() => burst(w * 0.85, h * 0.7, Math.round(60 * scale)), 450);
    setTimeout(() => burst(w / 2, h * 0.5, Math.round(80 * scale)), 900);
    setTimeout(() => burst(w * 0.3, h * 0.6, Math.round(50 * scale)), 1500);
    setTimeout(() => burst(w * 0.7, h * 0.6, Math.round(50 * scale)), 1800);
  }

  // Tap anywhere on the celebration card for more confetti
  $('#screen-celebrate').addEventListener('click', (e) => {
    if (e.target.id === 'replay-btn') return;
    burst(e.clientX, e.clientY, 40);
  });
})();
</script>
</body>
